; Script generated by Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=EfficiencyHub
AppVersion=2.4.0
AppPublisher=EfficiencyHub
AppPublisherURL=https://github.com/smitlad01/Efficiencyhub.git
AppSupportURL=https://github.com/smitlad01/Efficiencyhub.git
AppUpdatesURL=https://github.com/smitlad01/Efficiencyhub.git
DefaultDirName={autopf}\EfficiencyHub
DefaultGroupName=EfficiencyHub
DisableProgramGroupPage=yes
OutputBaseFilename=EfficiencyHub_Setup_v2.4.0
Compression=lzma
SolidCompression=yes
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\AutoEfficiencyWatcher.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\server.js"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\rules.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\public\*"; DestDir: "{app}\public"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\EfficiencyHub"; Filename: "{app}\AutoEfficiencyWatcher.exe"
Name: "{autodesktop}\EfficiencyHub"; Filename: "{app}\AutoEfficiencyWatcher.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\AutoEfficiencyWatcher.exe"; Description: "{cm:LaunchProgram,EfficiencyHub}"; Flags: nowait postinstall skipifsilent

[Code]
// Pre-flight Dependency & Permission Verification
function InitializeSetup(): Boolean;
var
  releaseKey: Cardinal;
  regSuccess: Boolean;
  ResultCode: Integer;
begin
  // 1. Mandatory Administrator Privilege Check
  if not IsAdminLoggedOn() then
  begin
    MsgBox('Administrator privileges are required to install EfficiencyHub.' + #13#10 +
           'Please right-click the setup file and select "Run as administrator".',
           mbCriticalError, MB_OK);
    Result := False;
    Exit;
  end;

  // 2. Microsoft .NET Framework 4.5+ Dependency Check
  regSuccess := RegQueryDWordValue(
    HKEY_LOCAL_MACHINE,
    'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full',
    'Release',
    releaseKey
  );

  if (not regSuccess) or (releaseKey < 378389) then
  begin
    MsgBox('EfficiencyHub requires Microsoft .NET Framework 4.5 or higher.' + #13#10 +
           'Please install .NET Framework 4.5 or later before running this installer.',
           mbCriticalError, MB_OK);
    Result := False;
    Exit;
  end;

  // 3. Node.js Runtime Check
  if not Exec('cmd.exe', '/c node -v', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
  begin
    MsgBox('EfficiencyHub requires the Node.js runtime to be installed and available in PATH.' + #13#10 +
           'Please install Node.js (v18+) from https://nodejs.org before continuing.',
           mbCriticalError, MB_OK);
    Result := False;
    Exit;
  end;

  Result := True;
end;
